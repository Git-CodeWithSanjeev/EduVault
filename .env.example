# YouTube Data API v3 Key
# Get your key from: https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=your_youtube_api_key_here

# Supabase Authentication Keys
# Get your project URL & Anon Key from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# PDF Proxy URL (Optional - defaults to /api/proxy on Vercel and http://localhost:3001/pdf/proxy in local dev)
# VITE_PROXY_URL=/api/proxy
